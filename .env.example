# 1) PRIVALOMA tikram įrašui. Kaip sukurti raktą — žiūrėkite README arba svetainės viršų.
# https://aistudio.google.com/apikey
# Failas turi vadintis tiksliai .env.local ir gulėti šalia package.json.
GEMINI_API_KEY=

# 2) NEBŪTINA. El. paštas aprašymui išsiųsti.
# https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_TO=

# 3) NEBŪTINA. Pigesnė transkripcija be tikro balsų atskyrimo.
# https://console.groq.com/keys
GROQ_API_KEY=
