# Rekomenduojama: nemokamas Google AI Studio raktas.
# https://aistudio.google.com/apikey
# Palaiko lietuvių kalbą ir tikrą balsų atskyrimą (Kalbėtojas 1 / Kalbėtojas 2).
GEMINI_API_KEY=

# Alternatyva: nemokamas Groq raktas (labai pigi transkripcija).
# https://console.groq.com/keys
# Whisper moka lietuviškai, bet balsų neatskiria iš garso —
# kalbėtojai priskiriami pagal pokalbio eigą.
GROQ_API_KEY=

# Jei abu raktai yra, naudojamas Gemini (geresnis balsų atskyrimas).
